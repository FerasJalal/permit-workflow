# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./permits.db

# ── Microsoft Graph (for sending emails) ──
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_SENDER_EMAIL=permits@yourorg.com

# ── Adobe Acrobat Sign ──
ADOBE_SIGN_BASE_URL=https://api.na1.adobesign.com/api/rest/v6
ADOBE_SIGN_ACCESS_TOKEN=your-access-token
ADOBE_SIGN_WEBHOOK_URL=https://your-domain.com/webhooks/adobe-sign

# ── SharePoint ──
SHAREPOINT_SITE_ID=your-site-id
SHAREPOINT_DRIVE_ID=your-drive-id
SHAREPOINT_FOLDER_PATH=/Permits/Signed

# ── App ──
APP_BASE_URL=http://localhost:8000
TEMPLATES_DIR=templates
UPLOADS_DIR=uploads
GENERATED_DIR=generated
LIBREOFFICE_PATH=soffice
